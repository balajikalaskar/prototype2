PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CRAWL_TIMEOUT_MS=30000
MAX_CONCURRENT_CRAWLS=5
MAX_RESPONSE_BYTES=2097152
MAX_TEXT_LENGTH=50000
MAX_LINKS=100
MAX_HEADINGS=100
MAX_REDIRECTS=5
HTTP_TIMEOUT_MS=8000
BROWSER_TIMEOUT_MS=15000
MAX_STRATEGY_ATTEMPTS=3
MAX_BROWSER_CONCURRENCY=2
MAX_SESSIONS=10
SESSION_TTL_MS=300000
MAX_BROWSER_REQUESTS=100
MAX_BROWSER_NETWORK_BYTES=8388608
TLS_BROWSER_PROFILE=chrome151
BROWSER_ENABLED=true
# Optional: http://username:password@proxy.example:8080
# PROXY_URL=
